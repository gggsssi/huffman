void inorder(struct tnode *root) 
{
    if (root == NULL)
        return;
    inorder(root->l);  
    printf("(%c, %d)\n", root->alpha, root->freq);
    inorder(root->r);
}

void Decode(struct tnode*root,char *arr)// works only if the user gives spaces for encoded binary for every letter.
{
     struct tnode *ex,*s=NULL;
     s=root;
     ex=root;
     if (root==NULL)// if no root
      {
         printf("error!!!\n");
         return;
        }
     int i=0,j=0;
     while(arr[j])
     {
            while(arr[i]!=' '&& arr[i]!='\0')//if its space or NULL char then it means one letter can be decoded.
            {
                if(arr[i]=='1')//if its 1 then go right.
                     ex=(ex)->r;
                else if(arr[i]=='0')//if its 0 then go left
                    ex=(ex)->l;
                i=i+1;
              }
      printf("%c",ex->alpha);//print the current nodes alpha (happens whenever you hit space or NULL)
      ex=s;//reset the current to root after printing.
      j=i+1;
      i=i+1;
    }
  }
