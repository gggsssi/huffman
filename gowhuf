struct tnode
{
    char alpha;
    int freq;
    struct tnode *l;
    struct tnode *r;
    struct tnode *nxt;
    };

struct tnode *createtnode(int freq, char cont)
 { 
    struct tnode *c=NULL;
    c=(struct tnode *)malloc(sizeof(struct tnode));
    c->freq=freq;
    c->alpha=cont;
    c->l=NULL;
    c->r=NULL;
    c->nxt=NULL;
    return(c);
  }  

